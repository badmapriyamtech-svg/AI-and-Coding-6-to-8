
x = int(input("Prime or not. Enter any number"))

if x > 1:
   
    for i in range(2, int(x**0.5) + 1):
        
        if x % i == 0:
            print(f"{x} is not a prime number.We can divide it by {i}")
            break
    else:
        
        print(f"{x} is a prime number.")
else:
    
    print(f"{x} is neither a prime number or a composite number.")